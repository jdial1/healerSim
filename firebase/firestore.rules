rules_version = '2';

// Overheal — public queue and room documents.
//
// The queue is public by design: strangers matching with strangers. What these
// rules exist to stop is one signed-in stranger acting *as* another — queue
// sniping, hijacking a room, or forging somebody else's actions.
//
// What they deliberately do NOT stop, because v1 is host-authoritative and no
// rule can express it: the host lying about the simulation, including about
// everyone's XP. That trade is recorded in the multiplayer plan.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A player's best clear of one dungeon. The document id is
    // "<dungeonId>_<uid>", so a player holds exactly one per dungeon and can
    // only hold their own. Times are public: that is the whole point of them.
    match /times/{entryId} {
      function mine() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'dungeonId', 'ticks', 'cls', 'level', 'at'])
          && d.uid == request.auth.uid
          && d.dungeonId is string
          && entryId == d.dungeonId + '_' + d.uid
          && d.ticks is int && d.ticks > 0
          && d.cls is string
          && d.level is int
          && d.at == request.time;
      }

      allow read: if signedIn();
      allow create: if signedIn() && mine();
      // A record only moves one way; a slower run is not news.
      allow update: if signedIn() && mine() && request.auth.uid == resource.data.uid
        && request.resource.data.ticks < resource.data.ticks;
      allow delete: if signedIn() && request.auth.uid == resource.data.uid;
    }

    // A player's best clear of one dungeon. The document id is
    // "<dungeonId>_<uid>", so a player holds exactly one per dungeon and can
    // only hold their own. Times are public: that is the whole point of them.
    match /times/{entryId} {
      function mine() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'dungeonId', 'ticks', 'cls', 'level', 'at'])
          && d.uid == request.auth.uid
          && d.dungeonId is string
          && entryId == d.dungeonId + '_' + d.uid
          && d.ticks is int && d.ticks > 0
          && d.cls is string
          && d.level is int
          && d.at == request.time;
      }

      allow read: if signedIn();
      allow create: if signedIn() && mine();
      // A record only moves one way; a slower run is not news.
      allow update: if signedIn() && mine() && request.auth.uid == resource.data.uid
        && request.resource.data.ticks < resource.data.ticks;
      allow delete: if signedIn() && request.auth.uid == resource.data.uid;
    }

    // A player waiting for a group. The document id *is* the uid, so a player
    // can only ever hold one queue entry and can only hold their own.
    match /queue/{uid} {
      // A complete, freshly-joined entry. Both times must be the server's:
      // the longest wait hosts the group, so a client that could backdate
      // enqueuedAt could make itself host of every group it joined, and one
      // that could forward-date lastSeen could leave an entry that never
      // looks abandoned.
      function freshEntry() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'role', 'dungeonId', 'enqueuedAt', 'lastSeen'])
          && d.uid == uid
          && d.role in ['TANK', 'DPS', 'HEALER']
          && d.dungeonId is string
          && d.enqueuedAt == request.time
          && d.lastSeen == request.time;
      }

      // "Still here". Only lastSeen may move, and only to the server's now,
      // which is what keeps a queue position from being rewritten mid-wait.
      function refresh() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen'])
          && request.resource.data.lastSeen == request.time;
      }

      // Every signed-in client reads the queue: matchmaking is done on the
      // clients, so they each need the same snapshot to agree on a group.
      allow read: if signedIn();

      allow create: if signedIn() && request.auth.uid == uid && freshEntry();
      // Re-joining over your own leftover entry is a fresh entry too;
      // otherwise one crash would lock a player out of the queue for good.
      allow update: if signedIn() && request.auth.uid == uid && (freshEntry() || refresh());

      // Leaving is yours alone -- without the uid check any stranger could
      // empty the queue. The one exception is an entry nobody has refreshed
      // for a minute, judged on the server's clock: every client already
      // ignores those (QUEUE_ENTRY_TTL_MS is far shorter), and this is how a
      // killed app's entry actually leaves the database rather than lingering
      // forever. 60s here must match QUEUE_ENTRY_SWEEP_MS in Matchmaking.kt.
      allow delete: if signedIn() && (
        request.auth.uid == uid
        || resource.data.lastSeen < request.time - duration.value(60, 's')
      );
    }

    // Live game state and the guests' action streams are NOT here: they live in
    // the Realtime Database (database.rules.json). Firestore's sustained write
    // limit is about one per second per document and the relay publishes at
    // 3-4 Hz, so a frame-rate document here would be throttled by design.
    // Firestore keeps what changes at human speed: the queue and the room.
    match /rooms/{roomId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.memberUids;
      }
      function isHost() {
        return signedIn() && request.auth.uid == resource.data.hostUid;
      }

      // Only members see the room. memberUids exists purely so this is
      // expressible -- rules cannot index into the members array of maps.
      allow read: if isMember();
      // You may only create a room you host, and only one you are in --
      // and whose id names you. Ids are derived from the group's uids
      // (roomIdFor) precisely so every client computes the same one, which
      // also makes them guessable; without the id check a stranger could
      // create the room a group is about to form and lock its host out.
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids
        && request.auth.uid in roomId.split('_')
        // Not dated in the future, or the clean-up rule below could never
        // apply and an abandoned room would stay for good.
        && request.resource.data.formedAtMs is int
        && request.resource.data.formedAtMs <= request.time.toMillis() + 60000;
      // The host owns the room, and cannot hand the host seat to someone who
      // is not in it. Phase 4's host migration writes through here.
      allow update: if isHost()
        && request.resource.data.hostUid in request.resource.data.memberUids;
      // The host deletes the room when a run ends. Any member may delete it
      // once it is an hour old -- far past any run -- which is how a room
      // whose host vanished stops holding everyone's uids forever.
      allow delete: if isHost()
        || (isMember() && resource.data.formedAtMs < request.time.toMillis() - 3600000);
    }
  }
}
