# Copy to android/keystore.properties for LOCAL release builds.
#
# That file is gitignored, along with *.jks and *.keystore — no signing key is
# ever committed. CI does not use this file at all: it passes the same four
# values as AEGIS_KEYSTORE_FILE / AEGIS_KEYSTORE_PASSWORD / AEGIS_KEY_ALIAS /
# AEGIS_KEY_PASSWORD, which take precedence when set.
#
# Generate an upload key with:
#   keytool -genkeypair -v -keystore upload.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias upload
#
# Back the keystore and all passwords up before using it once. Enrol in Play App
# Signing at first upload: Google then holds the app signing key and this is only
# the upload key, which is the one thing that can be reset if lost.

# Path relative to the android/ directory.
storeFile=upload.jks
storePassword=
keyAlias=upload
keyPassword=
