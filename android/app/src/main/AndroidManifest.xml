<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The app's first permission, and the moment "works fully in airplane
         mode" stopped being unconditionally true. Single player still never
         opens a socket; this is here for the opt-in public queue, which does
         nothing until you choose it. public/privacy.html says the same thing,
         and was updated in the same commit rather than two phases later. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No screenOrientation lock. targetSdk 36+ ignores it above 600dp anyway,
         so tablets and unfolded foldables already ran landscape and the manifest
         was simply claiming otherwise. The layout is width-constrained and
         centred, so it adapts. -->
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Aegis.Splash">

        <!-- Firebase ships a ContentProvider that initialises it at every
             launch, before any of this app's code runs and whether or not the
             player ever opted in. Removed, so that with multiplayer off no
             Firebase code runs at all: FirebaseBackend initialises it on
             demand instead, and only once somebody has chosen to queue.
             ViewModelQueueTest asserts the backend is never built offline. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.Aegis.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
