<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Aegis" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/obsidian</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
      The androidx splash theme backports the API 31 system splash to API 26+.
      installSplashScreen() swaps to postSplashScreenTheme on first frame.
    -->
    <style name="Theme.Aegis.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/obsidian</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_fg</item>
        <item name="postSplashScreenTheme">@style/Theme.Aegis</item>
    </style>
</resources>
